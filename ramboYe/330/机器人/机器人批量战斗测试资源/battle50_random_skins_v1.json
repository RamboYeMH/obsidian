              "Expr": "len(filter(session.skin_info_after, 'item.skinID == 2004 && to_int(item.invalidTime) == -1')) == 1 && len(filter(session.skin_info_after, 'item.skinID == 2002 && to_int(item.invalidTime) == -1')) == 1 && len(filter(session.skin_info_after, 'item.skinID == 1191 && to_int(item.invalidTime) == -1')) == 1 && len(filter(session.skin_info_after, 'item.skinID == 1189 && to_int(item.invalidTime) == -1')) == 1 && len(filter(session.skin_info_after, 'item.skinID == 110071 && to_int(item.invalidTime) == -1')) == 1 && len(filter(session.skin_info_after, 'item.skinID == 110070 && to_int(item.invalidTime) == -1')) == 1 && len(filter(session.skin_info_after, 'item.skinID == 110069 && to_int(item.invalidTime) == -1')) == 1 && len(filter(session.skin_info_after, 'item.skinID == 110068 && to_int(item.invalidTime) == -1')) == 1",
