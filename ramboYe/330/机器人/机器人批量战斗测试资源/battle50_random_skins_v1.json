            "session.skin_outer_before": "$.curOuterSkin"
          },
          "Next": "ExistingSkinChoice",
          "Request": "GetAllSkinReq",
          "Type": "Request"
        },
        "ReadSkinsAfter": {
          "Ack": "GetAllSkinAck",
