# Duplicate this file to a private path and adjust only values required by your local machine.
# Do not send the private copy to an agent or commit it: Mongo URIs may contain credentials.
# The compose file maps host.docker.internal to the Docker host. Services must listen on an
# address reachable from that bridge; loopback-only daemons need a local bind configuration change.

BENCHMARK_LOCAL_HOST=host.docker.internal
BENCHMARK_LOCAL_MONGO_URI=mongodb://host.docker.internal:27017/?replicaSet=rs0
BENCHMARK_LOCAL_NATS_URL=nats://host.docker.internal:4222
BENCHMARK_LOCAL_ETCD_ENDPOINTS=http://host.docker.internal:2379
BENCHMARK_LOCAL_GATEADDR=host.docker.internal:21001
BENCHMARK_LOCAL_IMAGE=gs-benchmark:local
BENCHMARK_LOCAL_ENV_ID=benchmark-local
BENCHMARK_LOCAL_SERVER_ID=1
BENCHMARK_LOCAL_MANAGER_PORT=28082
