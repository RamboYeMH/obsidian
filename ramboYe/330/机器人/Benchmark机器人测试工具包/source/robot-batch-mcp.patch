index 0000000000..6393bbbcee
--- /dev/null
+++ b/benchmark/backend/internal/blockmcp/robot_batch.go
@@ -0,0 +1,44 @@
+package blockmcp
+
+import (
+	"context"
+	"errors"
+	"net/http"
+
+	"github.com/modelcontextprotocol/go-sdk/mcp"
+)
+
+// 参数直接交给既有批量接口校验，不在 MCP 重写 ID 分配或机器人创建逻辑。
+type robotBatchInput struct {
+	EnvironmentID string `json:"environment_id" jsonschema:"explicit target environment ID"`
+	StartRobotID  int    `json:"start_robot_id,omitempty" jsonschema:"positive start of an inclusive ID range; mutually exclusive with robot_ids"`
+	EndRobotID    int    `json:"end_robot_id,omitempty" jsonschema:"end of the inclusive ID range"`
+	RobotIDs      []int  `json:"robot_ids,omitempty" jsonschema:"explicit positive robot IDs; mutually exclusive with the range"`
+	CountryCode   string `json:"country_code" jsonschema:"ISO country code, for example CN"`
+	Language      string `json:"language" jsonschema:"ISO 639-1 language code, for example zh"`
+	SkipExisting  bool   `json:"skip_existing,omitempty" jsonschema:"skip existing IDs only when intentionally reusing a previewed batch; default rejects conflicts"`
+}
+
+type createRobotBatchInput struct {
+	Batch   robotBatchInput `json:"batch" jsonschema:"the same batch parameters checked by preview_robot_batch"`
+	Confirm bool            `json:"confirm" jsonschema:"must be true to create robot master records within the authorized environment"`
+}
+
+// 只暴露已有接口；创建主档不等于角色已创建、登录或业务前置条件已满足。
+func registerRobotBatchTools(server *mcp.Server, controller RobotManagerController) {
+	mcp.AddTool(server, &mcp.Tool{
+		Name:        "preview_robot_batch",
+		Description: "Preview the existing robot batch-create API without writing. Returns create/existing IDs. Use only the intended test environment and the smallest needed batch; preview does not reserve IDs.",
+	}, func(ctx context.Context, _ *mcp.CallToolRequest, input robotBatchInput) (*mcp.CallToolResult, robotResourceOutput, error) {
+		return callRobotManager(ctx, controller, RobotManagerRequest{Method: http.MethodPost, Path: "/robots/batch-preview", Body: input})
+	})
+	mcp.AddTool(server, &mcp.Tool{
+		Name:        "create_robot_batch",
+		Description: "Create robot master records through the existing batch-create API after preview. Requires confirm=true. Does not log in, bind a profile or prepare game state. Afterwards call list_test_targets for these exact IDs and run an appropriate login/preparation Block. On conflicts re-preview; do not overwrite existing robots or blindly retry a changed batch.",
+	}, func(ctx context.Context, _ *mcp.CallToolRequest, input createRobotBatchInput) (*mcp.CallToolResult, robotResourceOutput, error) {
+		if !input.Confirm {
+			return nil, robotResourceOutput{}, errors.New("confirm=true is required")
+		}
+		return callRobotManager(ctx, controller, RobotManagerRequest{Method: http.MethodPost, Path: "/robots/batch-create", Body: input.Batch})
+	})
+}
